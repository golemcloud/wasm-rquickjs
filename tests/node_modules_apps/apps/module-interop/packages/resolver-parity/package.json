{
  "name": "resolver-parity",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./root.cjs",
      "require": "./root.cjs"
    },
    "./features/*": {
      "import": "./features/*.cjs",
      "require": "./features/*.cjs"
    },
    "./imports/esm": "./imports-esm.mjs",
    "./imports/cjs": "./imports-cjs.cjs"
  },
  "imports": {
    "#internal/*": {
      "import": "./internal/*.cjs",
      "require": "./internal/*.cjs"
    }
  }
}
