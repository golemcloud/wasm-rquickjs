+        let entry = trace.entry(category).or_default();
+        entry.calls = entry.calls.saturating_add(1);
+        if let Some(count) = entry.paths.get_mut(path) {
+            *count = count.saturating_add(1);
+        } else if entry.paths.len() < PATH_TRACE_LIMIT {
+            entry.paths.insert(path.to_owned(), 1);
+        } else {
+            entry.overflow_calls = entry.overflow_calls.saturating_add(1);
+        }
+    }
