package quickjs:node-http;

world node-http {
  export http-get: func(port: u16);
  export http-post-json: func(port: u16);
  export http-request-with-headers: func(port: u16);
  export http-constants: func();
  export http-self-connect: func();
  export http-self-connect-post: func();
  export http-abort-isolation: func() -> bool;
  export http-response-lifecycle: func() -> bool;
  export http-pipelined-response-order: func() -> bool;
  export http-half-open-pipelined-requests: func() -> bool;
  export http-pipelined-close-lifecycle: func() -> bool;
  export http-pipelined-connection-close: func() -> bool;
  export http-pipelined-active-timeout: func() -> bool;
  export http-close-idle-connections: func() -> bool;
  export http-informational-write-after-close: func() -> bool;
  export http-max-requests-closes-socket: func() -> bool;
  export net-writev-boundaries: func() -> bool;
  export net-write-profile: func(chunk-size: u32, chunk-count: u32, corked: bool) -> string;
  export http-pipelined-max-requests: func() -> bool;
  export http-custom-connection-rejected: func() -> bool;
}
